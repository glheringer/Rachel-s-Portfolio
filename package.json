{
  "name": "rachel-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "pnpm tokens && next dev",
    "build": "pnpm tokens && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm tokens && pnpm typecheck && pnpm lint && pnpm lint:styles && pnpm format:check"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "schema-dts": "^2.1.0",
    "style-dictionary": "^4.4.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.19"
  }
}
